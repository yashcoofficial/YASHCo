#!/bin/sh
set -eu

MAVEN_VERSION=3.9.9
MAVEN_USER_HOME=${MAVEN_USER_HOME:-${HOME}/.m2}
MAVEN_HOME="$MAVEN_USER_HOME/wrapper/dists/apache-maven-$MAVEN_VERSION/apache-maven-$MAVEN_VERSION"
MAVEN_EXEC="$MAVEN_HOME/bin/mvn"

if [ ! -x "$MAVEN_EXEC" ]; then
  CACHE_DIR=$(dirname "$MAVEN_HOME")
  TMP_DIR="$CACHE_DIR.tmp.$$"
  mkdir -p "$TMP_DIR"
  ARCHIVE="$TMP_DIR/apache-maven-$MAVEN_VERSION-bin.zip"
  curl -fsSL "https://repo.maven.apache.org/maven2/org/apache/maven/apache-maven/$MAVEN_VERSION/apache-maven-$MAVEN_VERSION-bin.zip" -o "$ARCHIVE"
  unzip -q "$ARCHIVE" -d "$TMP_DIR"
  mkdir -p "$CACHE_DIR"
  mv "$TMP_DIR/apache-maven-$MAVEN_VERSION" "$MAVEN_HOME"
fi

exec "$MAVEN_EXEC" "$@"